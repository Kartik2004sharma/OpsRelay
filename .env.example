FALKORDB_URL=falkor://127.0.0.1:6379
FALKORDB_GRAPH=opsrelay
OPSRELAY_OPERATOR_NAME=Operations lead
OPSRELAY_OPERATOR_PASSWORD=replace-with-at-least-20-random-characters
# Server only. Leave billing disabled on the provider account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloud-only document extraction/search; no local model.
GRAPHRAG_ENABLED=0
# Absolute interpreter path for the isolated SDK environment
GRAPHRAG_PYTHON=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
