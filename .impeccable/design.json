  "narrative": {
    "northStar": "Control tower",
    "overview": "A light control-tower workspace gives priority to connected commitments, current supply facts and the next review decision. Compact type, disciplined rules and a restrained blue action color keep the operational task legible.\n\nThe public landing and trust pages extend this world with generous display type, near-white paper, a responsive supply scenario and an expansive blue company-memory section. The operator workspace retains its compact hierarchy and existing tokens. Public examples disclose their synthetic or illustrative status beside the content.",
    "keyCharacteristics": [
      "Compact, factual task hierarchy.",
      "Clear relationship paths and chronological evidence.",
      "Consistent native controls and visible state feedback.",
      "Spacious public storytelling paired with compact operational detail."
    ],
    "rules": [
      {
        "name": "The State Text Rule",
        "body": "Every semantic color is paired with readable text.",
        "section": "colors"
      },
      {
        "name": "The Decision Trail Rule",
        "body": "A supply update changes current coverage while preserving dated source records and reviewed decisions.",
        "section": "components"
      },
      {
        "name": "The Public Evidence Rule",
        "body": "Label synthetic and illustrative previews beside their content and retain provenance for recorded interface media.",
        "section": "components"
      }
    ],
    "dos": [
      "Use actual graph results for relationships and statuses.",
      "Use visible text alongside semantic state colors.",
      "Keep mobile navigation and equivalent order controls accessible.",
      "Keep public color, type and spacing variants scoped to landing and trust surfaces.",
      "Label synthetic and illustrative content and retain walkthrough provenance."
    ],
    "donts": [
      "Do not add decorative eyebrows above headings.",
      "Do not use color alone to communicate risk.",
      "Do not hide core actions behind operator credentials when showing the synthetic demo."
    ]
  }
}
